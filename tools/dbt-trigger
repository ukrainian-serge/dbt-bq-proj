#!/bin/bash

# Default values
GOOGLE_CREDENTIALS_FILE="$GOOGLE_PROD_CREDENTIALS"
CAUSE="from local CLI ($USER on $HOSTNAME)"

# ALL dbt cloud credentials are sourced from .envrc actication by direnv

# Print usage instructions
usage() {
  cat << EOF
Usage: $(basename "$0") [OPTIONS]

Description:
  Triggers a dbt Cloud job run via API v2.

Options:
  -c, --credentials PATH    Path to credentials file (default: $GOOGLE_CREDENTIALS_FILE)
  -m, --message STR         Trigger cause message (default: 'from local CLI ($USER on $HOSTNAME)')
  -h, --help                Show this help message and exit

Environment Variables:
  The credentials file (or active shell environment) must supply:
    DBT_CLOUD_ACCOUNT_ID    Your dbt Cloud account ID
    DBT_CLOUD_JOB_ID        Target job ID to run
    DBT_CLOUD_API_TOKEN     Service token or Personal Access Token
    DBT_CLOUD_HOST          dbt Cloud host (optional, default: cloud.getdbt.com)

Examples:
  $(basename "$0")
  $(basename "$0") -m "Triggered after dbt build in staging"
  $(basename "$0") -c $HOME/keys/dbt_cloud_credentials
EOF
  exit 0
}

# Parse named arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    -c|--credentials)
      GOOGLE_CREDENTIALS_FILE="$2"
      shift 2
      ;;
    -m|--message)
      CAUSE="$2"
      shift 2
      ;;
    -h|--help)
      usage
      ;;
    *)
      echo "❌ Unknown option: $1"
      echo "Use '$(basename "$0") -h' for usage information."
      exit 1
      ;;
  esac
done

# Load credentials
if [ -f "$GOOGLE_CREDENTIALS_FILE" ]; then
  source "$GOOGLE_CREDENTIALS_FILE"
else
  echo "❌ Error: Credentials file not found at $GOOGLE_CREDENTIALS_FILE"
  echo "Use '$(basename "$0") -h' for usage information."
  exit 1
fi

echo "🚀 Triggering Job ${DBT_CLOUD_JOB_ID} in Account ${DBT_CLOUD_ACCOUNT_ID}..."

# Make the API Call
RESPONSE=$(curl -s -X POST "https://${DBT_CLOUD_HOST}/api/v2/accounts/${DBT_CLOUD_ACCOUNT_ID}/jobs/${DBT_CLOUD_JOB_ID}/run/" \
  -H "Authorization: Token ${DBT_CLOUD_API_TOKEN}" \
  -H "Content-Type: application/json" \
  -d "{\"cause\": \"${CAUSE}\"}")

# Check for success using the actual JSON structure
if echo "$RESPONSE" | grep -q '"is_success":true'; then
  RUN_ID=$(echo "$RESPONSE" | grep -o '"id":[0-9]*' | head -1 | cut -d':' -f2)
  echo "✅ Success! Job triggered."
  echo "🔗 Run ID: ${RUN_ID}"
  echo "🌐 View in browser: https://${DBT_CLOUD_HOST}/#/accounts/${DBT_CLOUD_ACCOUNT_ID}/runs/${RUN_ID}"
else
  echo "❌ Failed to trigger job."
  echo "Response: $RESPONSE"
fi