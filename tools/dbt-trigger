#!/bin/bash

usage() {
  cat << EOF
dbt-trigger - Trigger a dbt Cloud job run via API from your local CLI.

USAGE:
  dbt-trigger [OPTIONS]

OPTIONS:
  -s, --steps <command>     Override job steps with a custom dbt command.
                            Defaults to: "dbt build --full-refresh"

  -m, --message <text>      Custom cause description attached to the run log.
                            Defaults to: "from local CLI ($USER on $HOSTNAME)"

  -h, --help                Show this help documentation.

EXAMPLES:
  # Trigger job with default step ("dbt build --full-refresh")
  dbt-trigger

  # Run a specific model and its downstream dependents
  dbt-trigger -s "dbt build --select int_customer_orders+"

  # Run with custom message log in dbt Cloud UI
  dbt-trigger -m "Manual trigger before prod deploy" -s "dbt test"
EOF
  exit 0
}

CAUSE="from local CLI ($USER on $HOSTNAME)"
STEPS_OVERRIDE='["dbt build --full-refresh"]'

# Parse named arguments
while [[ $# -gt 0 ]]; do
  case "$1" in
    -m|--message)
      CAUSE="$2"
      shift 2
      ;;
    -s|--steps)
      STEPS_OVERRIDE="[\"$2\"]"
      shift 2
      ;;
    -h|--help)
      usage
      ;;
    *)
      echo "❌ Unknown option: $1"
      exit 1
      ;;
  esac
done

# Build payload with steps_override always populated
PAYLOAD=$(jq -n --arg cause "$CAUSE" --argjson steps "$STEPS_OVERRIDE" \
  '{cause: $cause, steps_override: $steps}')

# Make the API Call
RESPONSE=$(curl -s -X POST "https://${DBT_CLOUD_HOST}/api/v2/accounts/${DBT_CLOUD_ACCOUNT_ID}/jobs/${DBT_CLOUD_JOB_ID}/run/" \
  -H "Authorization: Token ${DBT_CLOUD_API_TOKEN}" \
  -H "Content-Type: application/json" \
  -d "$PAYLOAD")

# Check for success using the actual JSON structure
if echo "$RESPONSE" | grep -q '"is_success":true'; then
  RUN_ID=$(echo "$RESPONSE" | grep -o '"id":[0-9]*' | head -1 | cut -d':' -f2)
  echo "✅ Success! Job triggered."
  echo "🔗 Run ID: ${RUN_ID}"
  echo "🌐 View in browser: https://${DBT_CLOUD_HOST}/#/accounts/${DBT_CLOUD_ACCOUNT_ID}/runs/${RUN_ID}"
else
  echo "❌ Failed to trigger job."
  echo "Response: $RESPONSE"
fi